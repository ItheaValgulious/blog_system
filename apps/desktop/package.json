{
  "name": "@blog-system/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsup src/main.ts src/preload.ts --format cjs --target node22 --out-dir dist --splitting false --clean --external electron",
